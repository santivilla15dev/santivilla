# Copy to .env.local — never commit real secrets

# Anthropic — design agent, menu OCR, bot, copy, maps understand, audit AI diagnosis
ANTHROPIC_API_KEY=

# Google PageSpeed Insights — audit Lighthouse
PAGESPEED_API_KEY=

# Google Places API (New) — Maps → Konzept Live (separate key from PageSpeed)
GOOGLE_PLACES_API_KEY=

# Supabase — concepts, menu drafts, copy drafts, audit reports, CRM (leads, sites, auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Optional — Higgsfield Nano Banana Pro images
HF_KEY=
# Opcional, imágenes de conceptos — alternativa a HF_KEY (keyId + secret por separado)
HF_CREDENTIALS=
HF_API_KEY_ID=
HF_API_KEY=
HF_API_KEY_SECRET=

# Public site CTAs
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CAL_URL=
# Origen absoluto para enlaces WhatsApp del Brief Agent (opcional; fallback Vercel/santivilla.com)
NEXT_PUBLIC_SITE_URL=

# Legal / Impressum (§ 5 ECG) — leave empty to show “[Por completar…]” placeholders
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_GISA=
NEXT_PUBLIC_LEGAL_FIRMENBUCH=
NEXT_PUBLIC_LEGAL_UID=
NEXT_PUBLIC_LEGAL_GEWERBEBEHOERDE=
NEXT_PUBLIC_LEGAL_WKO=

# CLI prospect:maps — defaults to http://localhost:3000
PROSPECT_BASE_URL=
